# Salin berkas ini menjadi .env lalu isi. JANGAN memasukkan .env ke git.

# Lokasi basis data SQLite. Di Docker, docker-compose.yml menimpanya menjadi file:/app/data/prod.db.
# Untuk menjalankan skrip di server (buat-admin, cadangan) gunakan jalur absolut.
DATABASE_URL="file:/app/data/prod.db"

# ID klien OAuth dari Google Cloud Console (jenis "Desktop app").
GOOGLE_CLIENT_ID=
# Rahasia klien OAuth yang berpasangan dengan ID di atas.
GOOGLE_CLIENT_SECRET=
# Diperoleh dengan menjalankan: node scripts/oauth.mjs  (aplikasi OAuth harus berstatus "In production").
GOOGLE_REFRESH_TOKEN=
# Opsional. Kosong = aplikasi membuat folder induk "Dokumen Guru" sendiri di Drive (disarankan; scope drive.file
# tidak bisa melihat folder buatan manual). Isi hanya dengan ID folder yang dibuat oleh aplikasi ini.
DRIVE_FOLDER_ID=

# Opsional, dibaca docker-compose.yml (isi di kolom Environment Komodo bila compose diambil dari git):
# DIR_DATA=./data                           # folder data di host (bawaan ./data)
# PORT_WEB=3000                             # port di host; port dalam kontainer tetap 3000
# BIND_HOST=127.0.0.1                       # 0.0.0.0 bila reverse proxy berupa kontainer atau mesin lain

# Hanya untuk tes otomatis; biarkan kosong. Diabaikan di produksi.
DRIVE_PALSU=

# Opsional, hanya untuk skrip cadangan: lokasi basis data dan folder salinan (bawaan: data/prod.db dan data/cadangan).
# BERKAS_DB=
# DIR_CADANGAN=

# Admin awal (opsional): dibuat otomatis saat kontainer mulai bila belum ada. Hapus ADMIN_SANDI setelah berhasil masuk.
# ADMIN_EMAIL=admin@sekolah.sch.id
# ADMIN_SANDI=minimal-8-karakter
# ADMIN_NAMA=Admin
# ADMIN_RESET=1   # sementara: ganti sandi admin yang sudah ada (lupa sandi)
