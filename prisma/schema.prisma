generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id         String   @id @default(cuid())
  nama       String
  email      String   @unique
  hashSandi  String
  aktif      Boolean  @default(true)
  dibuatPada DateTime @default(now())
}

model Guru {
  id         String   @id @default(cuid())
  nama       String
  // Username untuk masuk: NIP bagi ASN (PNS/PPPK/Paruh waktu), NIK bagi Non ASN.
  username   String   @unique
  nip        String?  @unique
  nik        String?  @unique
  email      String?  @unique // tidak dipakai lagi untuk masuk; dipertahankan untuk data lama
  // false = mendaftar sendiri dan belum disetujui admin; belum boleh masuk.
  disetujui  Boolean  @default(true)
  hashSandi  String
  aktif      Boolean  @default(true)
  dibuatPada DateTime @default(now())
  dokumen    DokumenGuru[]

  // Profil (diisi guru, boleh dikoreksi admin). Menentukan dokumen mana yang wajib.
  asalSekolah      String?
  statusPegawai    String?  // PNS | PPPK | PARUH_WAKTU | NON_ASN
  jabatan          String   @default("GURU") // GURU | KEPSEK
  tahunSertifikasi Int?
  sertifikasiBaru  Boolean  @default(false)
  tugasLabPerpus   Boolean  @default(false)
  tugasTbq         Boolean  @default(false)
  tugasRohis       Boolean  @default(false)
  tugasImtaq       Boolean  @default(false)
  tugasInklusi     Boolean  @default(false)
  tugasWakasek     Boolean  @default(false)
  tugasOsis        Boolean  @default(false)
  tugasWaliKelas   Boolean  @default(false)
  tugasPiket       Boolean  @default(false)
  tugasGuruWali    Boolean  @default(false)
}

model Periode {
  id         String   @id @default(cuid())
  nama       String
  dibuka     Boolean  @default(false)
  dibuatPada DateTime @default(now())
  dokumen    DaftarDokumen[]
  dokumenGuru DokumenGuru[]
}

model DaftarDokumen {
  id        String  @id @default(cuid())
  periodeId String
  periode   Periode @relation(fields: [periodeId], references: [id])
  nama      String
  urutan    Int
  aktif     Boolean @default(true)
  // Siapa yang wajib mengunggah; lihat BERLAKU di src/lib/syarat.ts.
  berlakuUntuk String @default("semua")
  dokumenGuru DokumenGuru[]
}

model DokumenGuru {
  id            String        @id @default(cuid())
  periodeId     String
  periode       Periode       @relation(fields: [periodeId], references: [id])
  guruId        String
  guru          Guru          @relation(fields: [guruId], references: [id])
  dokumenId     String
  dokumen       DaftarDokumen @relation(fields: [dokumenId], references: [id])
  fileId        String?
  namaFile      String?
  tipe          String?
  ukuran        Int?
  status        String        @default("BELUM")
  alasan        String?
  diperiksaOleh String?
  diperiksaPada DateTime?
  diunggahPada  DateTime?
  @@unique([periodeId, guruId, dokumenId])
}

model Riwayat {
  id        String   @id @default(cuid())
  waktu     DateTime @default(now())
  periodeId String
  guruId    String?
  dokumenId String?
  aksi      String
  alasan    String?
  oleh      String
  olehTipe  String

  @@index([guruId, dokumenId])
  @@index([periodeId, waktu])
}

model Sesi {
  token      String   @id
  pemilikId  String
  tipe       String
  kedaluwarsa DateTime
}

model PercobaanMasuk {
  kunci String   @id
  gagal Int      @default(0)
  sejak DateTime
}
